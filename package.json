{
	"name": "webark-im-template",
	"version": "0.1.0",
	"author": "Dogxi <hi@dogxi.me>",
	"description": "Reusable React IM frontend template for desktop and mobile chat apps.",
	"type": "module",
	"license": "MIT",
	"main": "./dist/lib/index.cjs",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js",
			"require": "./dist/lib/index.cjs"
		},
		"./styles.css": "./dist/lib/styles.css"
	},
	"files": [
		"dist/lib",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "bun run build:demo && bun run build:lib",
		"build:demo": "vite build",
		"build:example": "cd examples/minimal && bun install --frozen-lockfile && bun run typecheck && bun run build",
		"build:lib": "vite build --mode library",
		"preview": "vite preview --host 0.0.0.0 --outDir dist/demo",
		"test:e2e": "playwright test",
		"format": "prettier --check .",
		"test": "bun test tests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"lucide-react": "^0.561.0",
		"qrcode": "^1.5.4"
	},
	"peerDependencies": {
		"react": ">=18.3.0 || >=19.0.0",
		"react-dom": ">=18.3.0 || >=19.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"happy-dom": "^20.11.1",
		"prettier": "^3.9.6",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"typescript": "^5.9.3",
		"vite": "^7.2.7",
		"vite-plugin-dts": "^5.0.3"
	}
}
